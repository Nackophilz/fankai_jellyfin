<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>3.1.0</AssemblyVersion>
    <FileVersion>3.1.0</FileVersion>
    <Version>3.1.0</Version>
    <Description>Fournit des métadonnées depuis l'API Fankai.</Description>
    <AssemblyName>Jellyfin.Plugin.Fankai</AssemblyName>
    <PluginName>$(AssemblyName)</PluginName>
    <PluginClassName>Jellyfin.Plugin.Fankai.Plugin</PluginClassName>
    <PluginId>4b725b9a-9063-4cb7-9533-ceaf32c6c86d</PluginId>
    <PluginManifestUrl>https://raw.githubusercontent.com/Nackophilz/fankai_plugin/refs/heads/main/manifest.json</PluginManifestUrl>
    <Configurations>Debug;Release;Jellyfin;Jellyfin12;Emby</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Emby'">
    <DefineConstants>$(DefineConstants);__EMBY__</DefineConstants>
    <OutputPath>bin/Emby</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Emby'">
    <DefineConstants>$(DefineConstants);JELLYFIN</DefineConstants>
    <OutputPath>bin/Jellyfin</OutputPath>
  </PropertyGroup>

  <!-- Majeur suivant : un serveur 12.x doit toujours préférer cette build à la 10.x de la même release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Jellyfin12'">
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin/Jellyfin12</OutputPath>
    <VersionJellyfin12>$([MSBuild]::Add($([System.Version]::Parse('$(Version)').Major), 1))$(Version.Substring($(Version.IndexOf('.'))))</VersionJellyfin12>
    <AssemblyVersion>$(VersionJellyfin12)</AssemblyVersion>
    <FileVersion>$(VersionJellyfin12)</FileVersion>
    <Version>$(VersionJellyfin12)</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Emby' And '$(Configuration)' != 'Jellyfin12'">
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Jellyfin12'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Emby'">
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
