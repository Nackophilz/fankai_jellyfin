<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="metadata.tvshows.fankai" name="Fankai" version="1.0.0" provider-name="Nackophilz">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="xbmc.metadata" version="2.1.0"/>
  </requires>
  <extension point="xbmc.metadata.scraper.tvshows" library="main.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="fr_FR">Par les fans, pour les fans</summary>
    <summary lang="en_GB">By fans, for fans</summary>
    <description lang="fr_FR">Fournisseur d'informations pour les séries Fan-Kai depuis l'API communautaire metadata.fankai.fr</description>
    <description lang="en_GB">Information provider for Fan-Kai series from the community API metadata.fankai.fr</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Nackophilz/fankai_kodi</source>
    <website>https://fankai.fr</website>
    <news>1.0.0
- Première version de l'add-on Fankai pour Kodi
    </news>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
