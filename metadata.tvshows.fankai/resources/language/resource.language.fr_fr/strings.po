msgctxt "#32000"
msgid "General"
msgstr "Général"

msgctxt "#32001"
msgid "Use the original title as the show title"
msgstr "Utiliser le titre original comme titre de la série"

msgctxt "#32002"
msgid "Name seasons after the API (story arcs)"
msgstr "Nommer les saisons d'après l'API (arcs)"

msgctxt "#32003"
msgid "Add the edit type (Kaï, Henshū…) as a tag"
msgstr "Ajouter le type d'édition (Kaï, Henshū…) comme tag"

msgctxt "#32004"
msgid "Trailers"
msgstr "Bandes-annonces"

msgctxt "#32010"
msgid "Advanced"
msgstr "Avancé"

msgctxt "#32011"
msgid "Verbose logging"
msgstr "Journal détaillé"

msgctxt "#32012"
msgid "API URL"
msgstr "URL de l'API"

msgctxt "#32020"
msgid "Metadata"
msgstr "Métadonnées"

msgctxt "#32101"
msgid "Show the Japanese/original title instead of the French one."
msgstr "Affiche le titre japonais/original à la place du titre français."

msgctxt "#32102"
msgid "Seasons take the arc names provided by the API (e.g. East Blue) instead of \"Season 1\"."
msgstr "Les saisons prennent les noms d'arcs fournis par l'API (ex. East Blue) au lieu de « Saison 1 »."

msgctxt "#32103"
msgid "Adds a library tag with the Fan-Kai edit type, handy for filtering."
msgstr "Ajoute un tag de médiathèque avec le type d'édition Fan-Kai, pratique pour filtrer."

msgctxt "#32104"
msgid "Set the YouTube trailer when the API provides one (requires the YouTube add-on)."
msgstr "Renseigne la bande-annonce YouTube quand l'API en fournit une (nécessite l'add-on YouTube)."

msgctxt "#32111"
msgid "Write debug messages to kodi.log."
msgstr "Écrit les messages de débogage dans kodi.log."

msgctxt "#32112"
msgid "Base URL of the Fankai metadata API. Only change it to use a local or mirrored instance."
msgstr "URL de base de l'API de métadonnées Fankai. À ne modifier que pour une instance locale ou un miroir."
